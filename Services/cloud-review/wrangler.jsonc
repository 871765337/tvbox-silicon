{
  "$schema": "../../website/node_modules/wrangler/config-schema.json",
  "name": "yingxia-cloud-review",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-22",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "yingxia-review.getmegaportal.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
